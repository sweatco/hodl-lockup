    "root_schema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "String",
      "type": "string",
      "definitions": {
        "AccountId": {
          "description": "NEAR Account Identifier.\n\nThis is a unique, syntactically valid, human-readable account identifier on the NEAR network.\n\n[See the crate-level docs for information about validation.](index.html#account-id-rules)\n\nAlso see [Error kind precedence](AccountId#error-kind-precedence).\n\n## Examples\n\n``` use near_account_id::AccountId;\n\nlet alice: AccountId = \"alice.near\".parse().unwrap();\n\nassert!(\"ƒelicia.near\".parse::<AccountId>().is_err()); // (ƒ is not f) ```",
          "type": "string"
        },
        "Checkpoint": {
          "type": "object",
          "required": [
            "balance",
            "timestamp"
          ],
          "properties": {
            "balance": {
              "type": "string"
            },
            "timestamp": {
              "description": "The unix-timestamp in seconds since the epoch.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            }
          }
        },
        "LockupClaim": {
          "type": "object",
          "required": [
            "claim_amount",
            "index",
            "is_final"
          ],
          "properties": {
            "claim_amount": {
              "type": "string"
            },
            "index": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            },
            "is_final": {
              "type": "boolean"
            }
          }
        },
        "LockupView": {
          "type": "object",
          "required": [
            "account_id",
            "schedule",
            "timestamp",
            "total_balance",
            "unclaimed_balance"
          ],
          "properties": {
            "account_id": {
              "$ref": "#/definitions/AccountId"
            },
            "claimed_balance": {
              "default": "0",
              "type": "string"
            },
            "schedule": {
              "$ref": "#/definitions/Schedule"
            },
            "termination_config": {
              "description": "An optional configuration that allows vesting/lockup termination.",
              "anyOf": [
                {
                  "$ref": "#/definitions/TerminationConfig"
                },
                {
                  "type": "null"
                }
              ]
            },
            "timestamp": {
              "description": "The current timestamp",
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            },
            "total_balance": {
              "type": "string"
            },
            "unclaimed_balance": {
              "type": "string"
            }
          }
        },
        "OrderExecution": {
          "type": "object",
          "required": [
            "account_id",
            "details",
            "total_approved"
          ],
          "properties": {
            "account_id": {
              "$ref": "#/definitions/AccountId"
            },
            "details": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": [
                  {
                    "type": "integer",
                    "format": "uint128",
                    "minimum": 0.0
                  },
                  {
                    "type": "integer",
                    "format": "uint128",
                    "minimum": 0.0
                  }
                ],
                "maxItems": 2,
                "minItems": 2
              }
            },
            "total_approved": {
              "type": "integer",
              "format": "uint128",
              "minimum": 0.0
            }
          }
        },
        "Promise": true,
        "PromiseOrValueNull": {
          "type": "null"
        },
        "PromiseOrValueOrdersExecutionResult": {
          "type": "object",
          "required": [
            "approved",
            "rejected"
          ],
          "properties": {
            "approved": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "format": "uint128",
                "minimum": 0.0
              }
            },
            "rejected": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/AccountId"
              }
            }
          }
        },
        "PromiseOrValueString": {
          "type": "string"
        },
        "Schedule": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Checkpoint"
          }
        },
        "TerminationConfig": {
          "type": "object",
          "required": [
            "beneficiary_id",
            "vesting_schedule"
